# App local. Host 127.0.0.1 chỉ lắng nghe trên máy này.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3001
DEMO_MODE=true
SEED_DEMO=true
# DATABASE_PATH=backend/storage/pharmacy.sqlite
# PRESCRIPTIONS_PATH=backend/storage/prescriptions

# Điền khóa Gemini để diễn đạt lại thông tin chính sách đã được duyệt.
GEMINI_API_KEY=
# JSON array hoặc các key cách nhau bởi dấu phẩy. Hỗ trợ tối đa 5 key.
GEMINI_API_KEYS=[]
GEMINI_MODEL=gemini-4-hydrogen

# Đăng nhập Google OAuth, dùng OAuth Client dạng Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP khi DEMO_MODE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Hai giá trị do VNPay Sandbox cấp. Bỏ trống để dùng COD và mô phỏng.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Chỉ dùng khi tạo cơ sở dữ liệu riêng không nạp tài khoản demo.
# Chạy npm run init:admin sau khi cấu hình DATABASE_PATH và DEMO_MODE=false.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Khi dùng PostgreSQL trên Supabase. Giữ các giá trị này phía máy chủ.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# DATABASE_CA_CERT=
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_ATTACHMENTS_BUCKET=minhan-private
# SEED_SAMPLE_CATALOG=false

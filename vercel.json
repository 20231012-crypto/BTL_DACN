{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["hnd1"],
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__minhan_path=:path*"
    },
    { "source": "/products/:path*", "destination": "/index.html" },
    { "source": "/orders/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    {
      "source": "/:page(cart|checkout|login|register|forgot-password|verify|account|chat|prescription|consultation)",
      "destination": "/index.html"
    }
  ]
}

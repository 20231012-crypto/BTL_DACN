{
  "name": "an-tam-pharmacy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hệ thống nhà thuốc trực tuyến An Tâm theo báo cáo Nhóm 11",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node backend/server.js",
    "init:admin": "node backend/init-admin.js",
    "seed:accounts": "node backend/seed-accounts.js",
    "db:setup": "node backend/setup-postgres.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "vite": "^7.2.2"
  }
}
